<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.MvcTestActivity">


    <!-- 1. 沙盒测试标题 -->
    <TextView
    android:id="@+id/tvSandboxTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:text="🔥 微头条 Day 1：MVC 沙盒演练场"
    android:textSize="20sp"
    android:textStyle="bold"
    android:textColor="#FF3333"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. 为明天准备的富文本输入框草稿（演示用） -->
    <EditText
    android:id="@+id/etSandboxInput"
    android:layout_width="0dp"
    android:layout_height="150dp"
    android:layout_margin="16dp"
    android:background="#F5F5F5"
    android:gravity="top|start"
    android:hint="明天我们将在这里测试 #话题# 变色输入..."
    android:padding="12dp"
    app:layout_constraintTop_toBottomOf="@id/tvSandboxTitle"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="点击测试底层 API"
        app:layout_constraintTop_toBottomOf="@id/etSandboxInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" /> <!--  这里统一闭合 -->
</androidx.constraintlayout.widget.ConstraintLayout>