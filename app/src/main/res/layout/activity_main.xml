<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 顶部标题栏 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mai"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wtt_topbar_height"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/wtt_spacing_standard"
                android:text="@string/wtt_btn_cancel"
                android:textSize="16sp"
                android:textColor="#333333"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wtt_title_publish"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_publish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/wtt_spacing_standard"
                android:text="@string/wtt_btn_publish"
                android:enabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 内容滚动区域 -->
        <ScrollView
            android:id="@+id/kta"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/formatting_toolbar_container"
            app:layout_constraintTop_toBottomOf="@id/mai">

            <LinearLayout
                android:id="@+id/kt_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="15dp">

                <EditText
                    android:id="@+id/ktg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wtt_input_min_height"
                    android:padding="@dimen/wtt_spacing_standard"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/wtt_hint_input"
                    android:inputType="textMultiLine" />

                <!-- 九宫格图片容器 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/wtt_spacing_standard"
                    android:overScrollMode="never" />

            </LinearLayout>
        </ScrollView>

        <!-- 格式化工具栏（第二行，B/I/A） -->
        <LinearLayout
            android:id="@+id/formatting_toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/wtt_spacing_standard"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_toolbar_container">

            <TextView
                android:id="@+id/bar_bold"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/bar_italic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/bar_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="A"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- 底部工具栏 -->
        <LinearLayout
            android:id="@+id/bottom_toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="#FAFAFA"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/wtt_spacing_standard"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/bar_topic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="# 话题"
                android:textColor="#2A62FF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bar_mention"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@ 提及"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/bar_emoji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☺ 表情"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/bar_photo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📷 照片"
                android:textColor="#555555" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading 遮罩 -->
    <ProgressBar
        android:id="@+id/progressBarOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
