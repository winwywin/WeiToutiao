<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 顶部标题栏 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mai"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wtt_topbar_height"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/wtt_spacing_standard"
                android:text="@string/wtt_btn_cancel"
                android:textSize="16sp"
                android:textColor="#333333"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wtt_title_publish"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_publish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/wtt_spacing_standard"
                android:text="@string/wtt_btn_publish"
                android:enabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 内容滚动区域 -->
        <ScrollView
            android:id="@+id/kta"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/formatting_toolbar_container"
            app:layout_constraintTop_toBottomOf="@id/mai">

            <LinearLayout
                android:id="@+id/kt_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="15dp">

                <EditText
                    android:id="@+id/ktg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wtt_input_min_height"
                    android:padding="@dimen/wtt_spacing_standard"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/wtt_hint_input"
                    android:inputType="textMultiLine" />

                <!-- Day 17+: 字数统计 -->
                <TextView
                    android:id="@+id/tv_char_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingHorizontal="@dimen/wtt_spacing_standard"
                    android:paddingBottom="4dp"
                    android:text="@string/wtt_char_count_placeholder"
                    android:textSize="12sp"
                    android:textColor="#999999" />

                <!-- 九宫格图片容器 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/wtt_spacing_standard"
                    android:overScrollMode="never" />

            </LinearLayout>
        </ScrollView>

        <!-- 格式化工具栏（第二行，B/I/A） -->
        <LinearLayout
            android:id="@+id/formatting_toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/wtt_spacing_standard"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_toolbar_container">

            <TextView
                android:id="@+id/bar_bold"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/bar_italic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/bar_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="A"
                android:textSize="16sp"
                android:textColor="#555555"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- 底部工具栏 -->
        <LinearLayout
            android:id="@+id/bottom_toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="#FAFAFA"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/wtt_spacing_standard"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/bar_topic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="# 话题"
                android:textColor="#2A62FF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bar_mention"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@ 提及"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/bar_emoji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☺ 表情"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/bar_photo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📷 照片"
                android:textColor="#555555" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading 遮罩（Day 17 升级：水平进度条 + 步骤文字） -->
    <LinearLayout
        android:id="@+id/progressBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CCFFFFFF"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_upload_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备发布..."
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/pb_upload_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="240dp"
            android:layout_height="8dp"
            android:progress="0"
            android:max="100"
            android:progressTint="#F85149"
            android:progressBackgroundTint="#E0E0E0" />

        <TextView
            android:id="@+id/tv_upload_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Day 17+: 发布成功页 -->
    <LinearLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 成功图标 -->
        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="36sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/success_circle_bg"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tv_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wtt_publish_success_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <!-- 发布内容摘要卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F8F8"
            android:layout_marginHorizontal="32dp"
            android:padding="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tv_success_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#333333"
                android:maxLines="4"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tv_success_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- 底部操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="32dp">

            <Button
                android:id="@+id/btn_success_continue"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/wtt_btn_continue_publish"
                android:textSize="16sp"
                android:textColor="#F85149"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_success_back"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/wtt_btn_back_home"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F85149" />

        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
